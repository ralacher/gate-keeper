# ── Home Assistant ─────────────────────────────────────────────
# Base URL of your Home Assistant instance (used by the Vite dev proxy)
VITE_HA_BASE_URL=http://192.168.0.2:8123

# Long-lived access token — server-side only (injected by nginx/Vite proxy).
# Never use a VITE_ prefix here; this must not appear in the browser bundle.
# Generate in Home Assistant: Profile → Long-Lived Access Tokens → Create Token
HA_TOKEN=your-ha-long-lived-token

# Webhook IDs for gate actions (Settings → Automations → Webhook trigger)
VITE_HA_WEBHOOK_OPEN=your-webhook-id-open
VITE_HA_WEBHOOK_OPEN_AND_LATCH=your-webhook-id-open-and-latch
VITE_HA_WEBHOOK_UNLATCH=your-webhook-id-unlatch

# ── go2rtc video feed ───────────────────────────────────────────
VITE_GO2RTC_URL=http://192.168.0.2:1984
VITE_GO2RTC_STREAM=gate_camera

# Video crop — CSS zoom into a region of the camera feed
# Set SCALE to 0 or 1 (or omit) to disable cropping and show the full frame.
VITE_VIDEO_CROP_SCALE=3.5
VITE_VIDEO_CROP_ORIGIN_X=0%
VITE_VIDEO_CROP_ORIGIN_Y=30%

# Video point-of-interest rectangle — highlights an area on the feed
# All values are percentages relative to the visible (cropped) frame.
# Leave any blank to disable the overlay.
VITE_VIDEO_POI_LEFT=35%
VITE_VIDEO_POI_TOP=15%
VITE_VIDEO_POI_WIDTH=20%
VITE_VIDEO_POI_HEIGHT=40%
VITE_VIDEO_POI_LABEL=Gate
VITE_VIDEO_POI_COLOR=rgba(239,68,68,0.7)

# ── Web Push (VAPID) ────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# (web-push is a project dependency in push-server/)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:gate@example.com

# ── Development ─────────────────────────────────────────────────
# Set to true to use simulated gate responses (no real HA needed)
VITE_MOCK=true

# Feature flag for RF latch capabilities
# Set to false to disable Open & Latch, Unlatch controls, and the latch status toggle.
VITE_FEATURE_LATCH_ENABLED=true

# Feature flag for experimental gate-position detection via pixel sampling
# When enabled, the app samples a small region of the camera feed and infers
# whether the gate is open or closed based on brightness.
VITE_FEATURE_GATE_DETECTION_ENABLED=false

# Gate detection configuration
# Sample point as % of the raw (uncropped) video frame (0-100)
VITE_GATE_DETECT_SAMPLE_X=50
VITE_GATE_DETECT_SAMPLE_Y=50
# Square area side length in pixels to average
VITE_GATE_DETECT_SAMPLE_SIZE=20
# Polling interval in milliseconds
VITE_GATE_DETECT_INTERVAL=2000
# Brightness threshold (0-255) dividing open from closed
VITE_GATE_DETECT_THRESHOLD=128
# "true" = brightness >= threshold means open; "false" = inverted
VITE_GATE_DETECT_OPEN_ABOVE=true
